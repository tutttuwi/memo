# Clasp ignore file
# このファイルに記載されたパターンは clasp push で除外されます

# フロントエンドのソースコード（page配下に移動）
page/frontend/
page/frontend/**

# 依存関係
page/frontend/node_modules/
page/frontend/node_modules/**

# ビルド成果物（index.htmlは含める）
page/frontend/dist/
page/frontend/dist/**
!page/frontend/dist/index.html

# assetsフォルダは除外（すべてindex.htmlにインライン化されているため）
page/gas/assets/
page/gas/assets/**

# 設定ファイル
.gitignore
.claspignore
README.md
LICENSE

# サンプルファイル
sample/
sample/**

# プロジェクトフォルダ（各プロジェクトは独自の.claspignoreを使用）
page/
page/**
api/
api/**

# その他
*.log
.DS_Store
